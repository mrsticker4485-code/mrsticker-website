{
  "name": "mrsticker-desktop",
  "version": "1.0.0",
  "description": "Mr Sticker Auto Repair — Desktop App",
  "main": "main.js",
  "author": "Mr Sticker Auto Repair",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.mrsticker.desktop",
    "productName": "Mr Sticker Auto Repair",
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.business"
    }
  }
}
